{
  "configurations": [
    {
      "name": "NUCLEO-H723ZG",
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": ["-mcpu=cortex-m7", "-mthumb", "-mfpu=fpv5-d16", "-mfloat-abi=hard"],
      "includePath": [
        "${workspaceFolder}/NUCLEO-H723ZG/src/**",
        "${workspaceFolder}/NUCLEO-H723ZG/cmsis/core",
        "${workspaceFolder}/NUCLEO-H723ZG/cmsis/device"
      ],
      "defines": ["STM32H723xx", "USE_PWR_LDO_SUPPLY"],
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-arm"
    },
    {
      "name": "NUCLEO-N657X0-Q",
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": ["-mcpu=cortex-m55", "-mthumb", "-mfloat-abi=hard", "-mcmse"],
      "includePath": [
        "${workspaceFolder}/NUCLEO-N657X0-Q/src/**",
        "${workspaceFolder}/NUCLEO-N657X0-Q/cmsis/core",
        "${workspaceFolder}/NUCLEO-N657X0-Q/cmsis/device"
      ],
      "defines": ["STM32N657xx"],
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-arm"
    }
  ],
  "version": 4
}
